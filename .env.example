# Couple Budgeter — Environment Variables
# Copy this file to .env.local and fill in values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the invite/household routes and /api/agent-ingest.
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Agent ingestion — see supabase/AGENT_INGESTION.md.
# Shared secret the external agent sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
BUDGET_INGEST_TOKEN=
# households.id that agent-pushed transactions belong to.
BUDGET_HOUSEHOLD_ID=

# The app has no Plaid credentials. The agent holds its own bank connection.
